<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.syncquote.ticker.mapper.TickerMapper">

    <resultMap id="tickerLatestMap" type="com.syncquote.ticker.entity.TickerLatest">
        <id column="exchange" property="exchange"/>
        <id column="market" property="market"/>
        <result column="trade_price" property="tradePrice"/>
        <result column="change_status" property="changeStatus"/>
        <result column="change_rate" property="changeRate"/>
        <result column="signed_change_rate" property="signedChangeRate"/>
        <result column="signed_change_price" property="signedChangePrice"/>
        <result column="acc_trade_price_24h" property="accTradePrice24h"/>
        <result column="acc_trade_volume_24h" property="accTradeVolume24h"/>
        <result column="high_price" property="highPrice"/>
        <result column="low_price" property="lowPrice"/>
        <result column="event_timestamp" property="eventTimestamp"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="korean_name" property="koreanName"/>
        <result column="english_name" property="englishName"/>
        <result column="market_warning" property="marketWarning"/>
    </resultMap>

    <!-- exchange: DB는 소문자(upbit/binance) 저장, API 계약은 대문자 → 매퍼 경계에서 변환.
         market_warning: DB는 NULL 허용(바이낸스), API 계약은 non-null → NONE으로 보정. -->
    <sql id="tickerJoinSelect">
        SELECT
            UPPER(t.exchange) AS exchange,
            t.market,
            t.trade_price,
            t.change_status,
            t.change_rate,
            t.signed_change_rate,
            t.signed_change_price,
            t.acc_trade_price_24h,
            t.acc_trade_volume_24h,
            t.high_price,
            t.low_price,
            t.event_timestamp,
            t.updated_at,
            m.korean_name,
            m.english_name,
            COALESCE(m.market_warning, 'NONE') AS market_warning
        FROM ticker_latest t
        JOIN market_info m ON m.exchange = t.exchange AND m.market = t.market
    </sql>

    <select id="findTickers" resultMap="tickerLatestMap">
        <include refid="tickerJoinSelect"/>
        <where>
            <if test="exchange != null">AND t.exchange = LOWER(#{exchange})</if>
            <if test="markets != null and !markets.isEmpty()">
                AND t.market IN
                <foreach item="code" collection="markets" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
        </where>
        <choose>
            <when test="category == 'TOP_GAINERS'">ORDER BY t.signed_change_rate DESC</when>
            <when test="category == 'TOP_VOLUME'">ORDER BY t.acc_trade_price_24h DESC</when>
        </choose>
        <if test="limit != null">LIMIT #{limit}</if>
    </select>

    <select id="findTicker" resultMap="tickerLatestMap">
        <include refid="tickerJoinSelect"/>
        WHERE t.exchange = LOWER(#{exchange}) AND t.market = #{market}
    </select>

</mapper>
