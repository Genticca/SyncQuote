<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.syncquote.market.mapper.MarketMapper">

    <select id="existsMarket" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM market_info WHERE exchange = LOWER(#{exchange}) AND market = #{market}
        )
    </select>

</mapper>
